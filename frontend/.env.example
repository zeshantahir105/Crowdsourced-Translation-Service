# =============================================================================
# LingoHub frontend (Vite) — copy to .env
# Restart `npm run dev` after changes. Only VITE_* vars are exposed to the browser.
# =============================================================================

# --- API (REST) --------------------------------------------------------------
# Empty in local dev: same-origin requests + Vite proxy → backend (see vite.config.ts).
# Production or `vite preview` without proxy: full API origin, no trailing slash.
# Examples: https://api.yourdomain.com   or   http://localhost:4000
VITE_API_URL=

# --- Realtime (Socket.io) ----------------------------------------------------
# Must be the API server origin (WebSocket); not proxied like REST in dev.
VITE_SOCKET_URL=http://localhost:4000

# =============================================================================
# Optional / future — not read by the app until you add code that uses them.
# =============================================================================

# Error tracking (e.g. @sentry/react)
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=development

# Public analytics or feature flags
# VITE_GA_MEASUREMENT_ID=
# VITE_PUBLIC_POSTHOG_KEY=

# Stripe Checkout (public key only — never put secret keys in VITE_*)
# VITE_STRIPE_PUBLISHABLE_KEY=
