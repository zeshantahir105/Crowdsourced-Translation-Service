# =============================================================================
# LingoHub AI service (FastAPI) — copy to .env next to this folder
# Run from ai-service/:  uvicorn app.main:app --reload --port 8000
# =============================================================================

# --- OpenAI (primary neural translation + domain/tone) -------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- DeepL (backup MT — free tier uses api-free.deepl.com) -------------------
# https://www.deepl.com/pro-api — full key including :fx suffix for Free API
# Sent as header DeepL-Auth-Key (not in request body).
DEEPL_API_KEY=
# false = free API host (default). true = paid api.deepl.com
DEEPL_USE_PRO=false
# Optional override, e.g. https://api-free.deepl.com or https://api.deepl.com
# DEEPL_API_BASE=

# --- Internal auth (optional) ------------------------------------------------
# If set, backend must send the same value as header X-Service-Secret
SERVICE_SECRET=

# --- HTTP / CORS -------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Comma-separated origins for browser calls; * allows all (dev only)
CORS_ORIGINS=*

# =============================================================================
# Optional / future — not used by current code; set when you extend the service.
# =============================================================================

# Alternative / additional providers (implement in translate.py when needed)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Azure OpenAI
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=

# Observability
# SENTRY_DSN=
