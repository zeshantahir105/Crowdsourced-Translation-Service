# =============================================================================
# LingoHub API — copy to .env and fill in. No trailing slashes on URLs.
# =============================================================================

# --- PostgreSQL (required — Prisma) -----------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lingohub?schema=public

# --- HTTP server -------------------------------------------------------------
PORT=4000
NODE_ENV=development

# HTTP request logs (morgan). Default: "dev" when NODE_ENV≠production, else "combined".
# Examples: dev, combined, tiny, common
LOG_FORMAT=

# CORS: browser origin(s) of the React app — comma-separated; no trailing slash (must match browser Origin header)
# Example: https://my-app.vercel.app,https://my-app-git-main-team.vercel.app,http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# After Google OAuth, redirect user to this SPA origin (not the API port)
FRONTEND_URL=http://localhost:5173

# --- Auth (JWT) --------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Google OAuth ------------------------------------------------------------
# https://console.cloud.google.com/apis/credentials — Web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an “Authorized redirect URI” in Google Cloud exactly
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# --- Email (sign-up, login OTP, forgot-password) — SMTP (Nodemailer) ----------
# Examples: Mailtrap SMTP, Gmail (app password), SendGrid SMTP, Mailpit, SES SMTP, etc.
# Port 587/2525: use SMTP_SECURE=false (STARTTLS). Port 465: SMTP_SECURE=true (implicit TLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=LingoHub <noreply@example.com>
#
# Optional secret used to hash OTPs in the database (recommended in production).
OTP_PEPPER=

# --- AI microservice (FastAPI) -----------------------------------------------
AI_SERVICE_URL=http://localhost:8000
# Shared secret; if set, must equal ai-service SERVICE_SECRET (sent as X-Service-Secret)
AI_SERVICE_SECRET=
# OpenAI / DeepL keys are configured in ai-service/.env (not here).

# --- Plans & document limits (optional overrides) -----------------------------
FREE_MAX_TEXT_CHARS=5000
PREMIUM_MAX_TEXT_CHARS=100000
FREE_DOC_MAX_BYTES=
PREMIUM_DOC_MAX_BYTES=

# Comma-separated emails → assigned ADMIN on first signup (email or Google)
LINGOHUB_ADMIN_EMAILS=

# --- Stripe (Premium checkout) ----------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Local dev: Stripe cannot POST to localhost unless you run `stripe listen --forward-to http://localhost:4000/webhooks/stripe` and paste the whsec_ secret above. After checkout, the app also calls POST /billing/sync-checkout-session so Premium updates without webhooks.
# Price ID for subscription (Dashboard → Products → Price)
STRIPE_PRICE_PREMIUM=
# Webhook path: POST /webhooks/stripe (raw body — do not proxy through JSON parsers)
# Customer portal (cancel / payment method): enable in Stripe Dashboard → Settings → Billing → Customer portal; app uses POST /billing/create-portal-session

# =============================================================================
# Below: used by PRD / production roadmap — not all are read by code yet.
# Leave blank until you integrate each service.
# =============================================================================

# --- Redis (optional — BullMQ async AI drafts) --------------------------------
# When set: POST /translate and POST /documents enqueue AI draft generation; run in parallel:
#   npm run worker
# API uses Redis pub/sub so the worker can trigger Socket.IO `translation:update`.
# Leave empty to keep AI inline in the HTTP request (except /translate/preview, always inline).
# Example: redis://localhost:6379  or  rediss://:password@host:6380
REDIS_URL=

# --- MongoDB (rich text versions, glossaries TM blobs — optional split store)
MONGODB_URI=

# --- Elasticsearch / OpenSearch (full-text search, analytics) ---------------
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# --- Payments ----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# --- Observability ------------------------------------------------------------
SENTRY_DSN=
DATADOG_API_KEY=

# --- Push notifications (e.g. FCM) -----------------------------------------
# FCM_SERVER_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
