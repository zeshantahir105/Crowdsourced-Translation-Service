generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CONSUMER
  TRANSLATOR
  REVIEWER
  ADMIN
}

enum PlanTier {
  FREE
  PREMIUM
}

enum RequestStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  APPROVED
}

enum TaskRole {
  TRANSLATE
  REVIEW
}

enum TaskStatus {
  OPEN
  ASSIGNED
  DONE
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  name         String
  role         UserRole @default(CONSUMER)
  planTier     PlanTier @default(FREE)
  /// Password sign-ups must verify email; OAuth users are verified by the provider (default true for existing rows).
  emailVerified Boolean @default(true)
  /// SHA-256 hash of OTP (with server pepper); cleared after verification.
  emailVerificationCodeHash String?
  emailVerificationExpiresAt DateTime?
  /// Per-login OTP (password sign-in only); cleared after verify-login-otp.
  loginOtpCodeHash String?
  loginOtpExpiresAt DateTime?
  /// When set, PREMIUM is valid until this instant (null = no expiry / manual grant)
  subscriptionExpiresAt DateTime?
  googleId     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requestsCreated TranslationRequest[] @relation("RequestOwner")
  versions        TranslationVersion[]
  qualityScores   QualityScore[]
  tasksAssigned   Task[]               @relation("TaskAssignee")
  reputation      Reputation?
  apiKeys         ApiKey[]
  glossaries      Glossary[]
}

model TranslationRequest {
  id          String        @id @default(uuid())
  ownerId     String
  owner       User          @relation("RequestOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /// TEXT = pasted text; DOCUMENT = uploaded file (text extracted server-side)
  inputKind   String        @default("TEXT")
  sourceText  String        @db.Text
  sourceLang  String
  targetLang  String
  domain      String        @default("general")
  status      RequestStatus @default(DRAFT)
  aiDraft     String?       @db.Text
  attachmentOriginalName String?
  attachmentMime         String?
  attachmentPath         String?
  extractedCharCount     Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  versions TranslationVersion[]
  tasks    Task[]
}

model TranslationVersion {
  id           String   @id @default(uuid())
  requestId    String
  request      TranslationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  translatorId String
  translator   User     @relation(fields: [translatorId], references: [id], onDelete: Cascade)
  text         String   @db.Text
  score        Float?
  createdAt    DateTime @default(now())

  qualityScores QualityScore[]
}

model QualityScore {
  id         String   @id @default(uuid())
  versionId  String
  version    TranslationVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  rating     Int
  comments   String?  @db.Text
  createdAt  DateTime @default(now())

  @@unique([versionId, reviewerId])
}

model Reputation {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points    Int      @default(0)
  badges    String[] @default([])
  updatedAt DateTime @updatedAt
}

model Glossary {
  id              String   @id @default(uuid())
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sourceTerm      String
  translatedTerm  String
  context         String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ownerId])
}

model Task {
  id          String     @id @default(uuid())
  requestId   String
  request     TranslationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  role        TaskRole
  status      TaskStatus @default(OPEN)
  assignedAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}
