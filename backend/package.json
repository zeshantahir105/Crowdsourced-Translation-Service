{
  "name": "lingohub-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm install && npm run db:generate && npm run db:migrate:all",
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "worker": "node src/workers/lingoHubWorker.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:all": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.71.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.9.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.0",
    "nodemailer": "^8.0.4",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^1.1.1",
    "socket.io": "^4.8.1",
    "stripe": "^17.7.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "prisma": "^6.5.0"
  }
}
